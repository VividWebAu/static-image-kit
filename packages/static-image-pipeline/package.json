{
  "name": "@vividweb/static-image-pipeline",
  "version": "0.1.0",
  "description": "Static image pipeline for blur-up, clustering, and manifest generation",
  "type": "module",
  "main": "dist/pipeline.js",
  "types": "dist/pipeline.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pipeline.js",
      "types": "./dist/pipeline.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "bin": {
    "static-image-pipeline": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@types/node": "^20.0.0"
  }
}

