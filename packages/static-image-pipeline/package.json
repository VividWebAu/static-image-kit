{
  "name": "@vividwebau/static-image-pipeline",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Static image pipeline for blur-up, clustering, and manifest generation",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "image",
    "pipeline",
    "sharp",
    "static",
    "nextjs",
    "optimization",
    "avif",
    "webp",
    "manifest"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest/buildManifest.js",
      "types": "./dist/manifest/buildManifest.d.ts"
    }
  },
  "bin": {
    "static-image-pipeline": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --experimental-strip-types tests/cli-smoke.test.ts",
    "lint": "eslint src --ext .ts,.js || true",
    "clean": "rm -rf dist",
    "prepare:images": "static-image-pipeline run"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "sharp": "^0.35.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.55.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
